{
  "name": "jungle-gaming-distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "bun": ">=1.0.0 <2.0.0" },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "bunx tsc --noEmit",
    "migration:up": "bunx mikro-orm migration:up",
    "migration:down": "bunx mikro-orm migration:down",
    "migration:pending": "bunx mikro-orm migration:pending"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.6.17",
    "@mikro-orm/migrations": "^6.6.17",
    "@mikro-orm/nestjs": "^6.6.17",
    "@mikro-orm/postgresql": "^6.6.17",
    "@nestjs/common": "^11.1.14",
    "@nestjs/core": "^11.1.14",
    "@nestjs/platform-express": "^11.1.14",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.6.17",
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.3"
  }
}
